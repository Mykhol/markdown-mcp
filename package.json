{
  "name": "mcp-markdown-viewer",
  "version": "1.5.0",
  "description": "MCP server that renders markdown in a browser window with live updates",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-markdown-viewer": "dist/server.js"
  },
  "files": [
    "dist",
    "src/viewer.html"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "npm run build && playwright test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "markdown",
    "viewer",
    "model-context-protocol",
    "claude",
    "mermaid",
    "katex"
  ],
  "author": "Michael Howell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mykhol/markdown-mcp.git"
  },
  "homepage": "https://github.com/Mykhol/markdown-mcp#readme",
  "bugs": {
    "url": "https://github.com/Mykhol/markdown-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "open": "^10.1.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
